# Copy to /opt/wredd-dashboard/.env on the server, then: chmod 600 .env
# Never commit it.

# Test subdomain first; change to dashboard.wredd.com on cutover night (then re-run deploy/setup.sh).
APP_DOMAIN=vps.wredd.com

# New, server-only. Generate each with:  openssl rand -hex 32
POSTGRES_PASSWORD=
CRON_SECRET=

# Copy from Vercel -> Project -> Settings -> Environment Variables.
# Keep NEXTAUTH_SECRET identical to Vercel so nobody is logged out at cutover.
NEXTAUTH_SECRET=
RESEND_API_KEY=
CLOUDINARY_CLOUD_NAME=dma2pslvt
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Only for the move off Neon. DIRECT connection string (no "-pooler" in the host).
# Delete once Neon is retired.
NEON_URL=
