// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma v7: connection URL is configured in prisma.config.ts
}

/**
 * =========================
 * ENUMS
 * =========================
 */

enum Role {
  SUPER_ADMIN
  MANAGER
  BUSINESS_DEVELOPER
  REMOTE_WORKER
  ONSITE_EMPLOYEE
}

enum WorkerType {
  ONSITE_VIDEO_EDITOR
  REMOTE_VIDEO_EDITOR
  ONSITE_ANIMATOR
  REMOTE_ANIMATOR
  WEB_DEVELOPMENT
  OPERATIONS
}

// (Mini-Step 3)
enum WorkType {
  ONSITE
  REMOTE
}

// (Mini-Step 3)
enum ProjectPortal {
  UPWORK
  FIVERR
  DIRECT
  OTHER
}

// (Mini-Step 4)
enum BdCommissionTab {
  ACTIVE
  CLEARING
  DUE
  PAID
}

enum ProjectStatus {
  UNASSIGNED
  IN_PROGRESS
  DELIVERED
  REVISION
  COMPLETED
  CANCELLED
}

enum MessageType {
  TEXT
  LINK
  SYSTEM
  DELIVERY
  REVISION_REQUEST
  STATUS_CHANGE
  DEADLINE_EXTENDED
}

enum ProjectClass {
  C
  C_PLUS
  B
  B_PLUS
  A
  S
  S_PLUS
}

enum PaymentLineStatus {
  UNPAID
  PAID
  EXCEPTION_PAID
  VOIDED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AssignmentOutcome {
  ACTIVE
  COMPLETED
  CANCELLED
  REMOVED   // Manager explicitly removed worker (not a worker cancellation)
}

enum NotificationType {
  PROJECT_CREATED_UNASSIGNED // in-app only (dept feed)
  ASSIGNMENT_ADDED
  ASSIGNMENT_REMOVED
  PROJECT_STATUS_CHANGED
  PROJECT_MESSAGE
  PROJECT_COMPLETED
  PROJECT_CANCELLED
  PROJECT_RATED
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/**
 * =========================
 * USERS & DEPARTMENTS
 * =========================
 */

model User {
  id           String      @id @default(cuid())
  fullName     String
  username     String      @unique
  email        String      @unique
  passwordHash String
  role         Role
  workerType   WorkerType?

 // BD commission (Super Admin controlled)
  // Stored as decimal fraction: 0.35 = 35%
  bdCommissionRate Decimal? @db.Decimal(5, 4)

  // Onsite cost rate (PKR per hour) — used in BD commission overhead calc
  // Nullable: falls back to MonthlyFinanceConfig.avgOnsiteHourCostPkr
  onsiteHourRatePkr Int?

  // onsite performance (targets)
  targetMonthlyPoints Int @default(0)

  // project watching (adminish users)
  watchedProjects ProjectWatcher[]

  archivedAt DateTime?

  // profile + presence (Mini-Step 13)
  image        String?
  avatarPath   String?
  statusText   String?
  lastActiveAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  joinedAt  DateTime @default(now())

  // multi-department access
  departments UserDepartment[]

  // relations
  // BD ownership on projects (Mini-Step 3)
  bdOwnedProjects Project[] @relation("ProjectBdOwner")

  // BD commissions (Mini-Step 4)
  bdCommissions BdCommission[] @relation("BdCommissionBd")

  // BD commissions marked paid / exception paid (Mini-Step 5)
  bdCommissionPaid          BdCommission[] @relation("BdCommissionPaidBy")
  bdCommissionExceptionPaid BdCommission[] @relation("BdCommissionExceptionPaidBy")

  createdProjects Project[]           @relation("ProjectCreatedBy")
  assignments     ProjectAssignment[] @relation("AssignmentUser")
  assignedByLinks ProjectAssignment[] @relation("AssignmentAssignedBy")
  messages        ProjectMessage[]    @relation("MessageCreatedBy")
  activities      ProjectActivity[]   @relation("ActivityActor")
  ratingsGiven    ProjectRating[]     @relation("ProjectRatedBy")

  // payments (remote-only, split lines per project)
  paymentLines        ProjectPaymentLine[] @relation("PaymentLineUser")
  paymentMarkedByLogs ProjectPaymentLine[] @relation("PaymentMarkedBy")

  // onsite performance
  onsiteCredits      OnsitePointCredit[]   @relation("OnsiteCreditUser")
  onsiteCreditsSetBy OnsitePointCredit[]   @relation("OnsiteCreditSetBy")
  onsiteRatedBy      OnsiteProjectRating[] @relation("OnsiteRatedBy")

  bdAdjustments        BdCommissionAdjustment[]
  createdBdAdjustments BdCommissionAdjustment[] @relation("BdAdjustmentCreatedBy")

  // invites & password reset (Mini-Step 13)
  invitesCreated UserInvite[] @relation("InviteCreatedBy")
  passwordResets PasswordResetToken[]

  // notifications
  notifications           Notification[]         @relation("NotificationRecipient")
  notificationDeliveries  NotificationDelivery[] @relation("NotificationDeliveryRecipient")
  notificationPreferences NotificationPreference?

  @@index([role])
  @@index([workerType])
  @@index([email])
  @@index([joinedAt])
  @@index([bdCommissionRate])
}

model MonthlyFinanceConfig {
  id String @id @default(cuid())

  // YYYY-MM
  monthKey String @unique

  // USD -> PKR
  fxRate Decimal @db.Decimal(12, 4)

  // Fully-loaded onsite cost per hour (PKR)
  avgOnsiteHourCostPkr Int

  // Monthly fixed overhead bucket for REMOTE (PKR)
  remoteOverheadFixedPkr Int

  finalizedAt DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([monthKey])
  @@index([finalizedAt])
}

model Department {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             UserDepartment[]
  projects          Project[]
  inviteDepartments UserInviteDepartment[]
}

model UserDepartment {
  userId       String
  departmentId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@index([departmentId])
}

/**
 * =========================
 * PROJECT CLASS DEFINITIONS
 * =========================
 */

model ProjectClassDefinition {
  id         String       @id @default(cuid())
  class      ProjectClass @unique
  basePoints Int

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * =========================
 * PROJECTS (V1 FINAL)
 * =========================
 */

model Project {
  id          String  @id @default(cuid())
  title       String
  description String?

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  status ProjectStatus @default(UNASSIGNED)

  /**
   * ---- Status timestamps (NEW) ----
   * cancelledAt: set exactly when status becomes CANCELLED
   * statusChangedAt: set on every status change (useful for audits/analytics)
   */
  cancelledAt     DateTime?
  statusChangedAt DateTime?

  /**
   * ---- Deadline + Timer (V1 final) ----
   */
  deadlineHours           Int       @default(0)
  timerRunning            Boolean   @default(false)
  timerLastResumedAt      DateTime?
  timerAccumulatedSeconds Int       @default(0)

  /**
   * ---- Onsite (V1) ----
   */
  onsitePointsManual Int?

  projectClassDefinitionId String?
  projectClassDefinition   ProjectClassDefinition? @relation(fields: [projectClassDefinitionId], references: [id], onDelete: SetNull)

  classBasePointsAtFirstCompletion Int?
  extraPoints                      Int?

  watchers ProjectWatcher[]

  /**
   * ---- BD ownership (Mini-Step 3) ----
   */
  bdOwnerId String?
  bdOwner   User? @relation("ProjectBdOwner", fields: [bdOwnerId], references: [id], onDelete: SetNull)

  /**
   * ---- Finance (Mini-Step 3) ----
   * kept in separate table for long-term maintainability
   */
  finance ProjectFinance?

  /**
   * ---- BD Commissions (Mini-Step 4) ----
   */
  bdCommissions BdCommission[] @relation("BdCommissionProject")

  /**
   * ---- Remote (V1) ----
   */
  remotePrice Decimal?

  /**
   * ---- Immutable first completion ----
   */
  firstCompletedAt DateTime?

  /**
   * ---- Creator ----
   */
  createdById String
  createdBy   User @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * ---- Relations ----
   */
  assignments ProjectAssignment[]
  messages    ProjectMessage[]
  activities  ProjectActivity[]
  rating      ProjectRating?

  paymentLines ProjectPaymentLine[]

  onsiteRating  OnsiteProjectRating?
  onsiteCredits OnsitePointCredit[]

  @@index([departmentId])
  @@index([status])
  @@index([createdById])
  @@index([bdOwnerId])
  // NEW indexes (optional but recommended)
  @@index([cancelledAt])
  @@index([statusChangedAt])
}

/**
 * =========================
 * FINANCE (MINI-STEP 3)
 * =========================
 */

model ProjectFinance {
  id String @id @default(cuid())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Financial metadata (not for workers)
  clientName     String?
  clientUsername String?

  // Billing type (project type, NOT user workerType)
  workType WorkType @default(REMOTE)

  // Portal/platform
  portal ProjectPortal @default(OTHER)

  // Required (DB default prevents migration failure for existing rows)
  // New project creation enforces > 0 in server validation.
  priceUsd Decimal @default(0) @db.Decimal(12, 2)

  // existing (keep for now)
  platformFeeUsd Decimal? @db.Decimal(12, 2)

  // new
  platformFeePercent Decimal? @db.Decimal(5, 2) // e.g. 20.00 for 20%

  // Onsite-only
  allowedHours Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([portal])
  @@index([workType])
}

model BdCommissionAdjustment {
  id String @id @default(cuid())

  bdUserId String
  bdUser   User @relation(fields: [bdUserId], references: [id], onDelete: Cascade)

  monthKey String // YYYY-MM (same concept as your finance config monthKey)
  tab      BdCommissionTab // CLEARING | DUE | PAID

  amountPkr Decimal @db.Decimal(14, 2) // can be negative
  note      String

  dueOn  DateTime
  paidAt DateTime?

  createdById String
  createdBy   User @relation("BdAdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([bdUserId, monthKey])
  @@index([tab, dueOn])
}

/**
 * =========================
 * BD COMMISSION (MINI-STEP 4)
 * =========================
 */

model BdCommission {
  id String @id @default(cuid())

  // Relations
  projectId String
  project   Project @relation("BdCommissionProject", fields: [projectId], references: [id], onDelete: Cascade)

  bdId String
  bd   User @relation("BdCommissionBd", fields: [bdId], references: [id], onDelete: Restrict)

  // Month context
  completedMonthKey String

  // Tab state
  tab BdCommissionTab @default(ACTIVE)

  // Dates
  dueOn     DateTime
  payableOn DateTime

  // ---- Paid / Exception Paid (Mini-Step 5) ----
  paidAt   DateTime?
  paidNote String?
  paidById String?
  paidBy   User? @relation("BdCommissionPaidBy", fields: [paidById], references: [id], onDelete: SetNull)

  exceptionPaidAt   DateTime?
  exceptionPaidNote String?
  exceptionPaidById String?
  exceptionPaidBy   User? @relation("BdCommissionExceptionPaidBy", fields: [exceptionPaidById], references: [id], onDelete: SetNull)

  // ===== Snapshot Inputs =====
  workType WorkType
  portal   ProjectPortal

  priceUsd Decimal @db.Decimal(12, 2)

  // existing snapshot (keep for now)
  platformFeeUsd Decimal @db.Decimal(12, 2)

  // new snapshot (TEMP nullable for step1)
  platformFeePercent Decimal? @db.Decimal(5, 2)

  fxRate Decimal @db.Decimal(12, 4)

  avgOnsiteHourCostPkr   Int
  remoteOverheadFixedPkr Int

  allowedHours Int?

  bdRate Decimal @db.Decimal(5, 4)

  // ===== Computed =====
  netUsd          Decimal @db.Decimal(12, 2)
  netPkr          Decimal @db.Decimal(14, 2)
  overheadPkr     Decimal @db.Decimal(14, 2)
  profitPkr       Decimal @db.Decimal(14, 2)
  bdPayoutPkr     Decimal @db.Decimal(14, 2)
  companySharePkr Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, completedMonthKey])
  @@index([bdId, tab])
  @@index([completedMonthKey])
  @@index([payableOn])
  @@index([tab])
  @@index([paidAt])
  @@index([exceptionPaidAt])
}

/**
 * =========================
 * ASSIGNMENTS (RELATIONAL ONLY)
 * =========================
 */

model ProjectAssignment {
  id        String @id @default(cuid())
  projectId String
  userId    String

  assignedById String?
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

// ✅ Standalone worker-level outcome (does NOT affect Project.status)
  outcome              AssignmentOutcome @default(ACTIVE)
  cancelledForWorkerAt DateTime?
  completedAt          DateTime?

  // Hours allocated to this worker for this project (onsite only)
  // Nullable: only set for ONSITE_EMPLOYEE assignments
  allocatedHours Int?

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User    @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?   @relation("AssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
  @@index([assignedById])

  // helpful for reports
  @@index([outcome])
  @@index([cancelledForWorkerAt])
  @@index([completedAt])
}

/**
 * =========================
 * CHAT & ACTIVITY
 * =========================
 */

model ProjectMessage {
  id          String @id @default(cuid())
  projectId   String
  createdById String?

  type    MessageType
  content String?
  linkUrl String?
  meta    Json?

  createdAt DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("MessageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([type])
  @@index([createdById])
}

model ProjectActivity {
  id        String @id @default(cuid())
  projectId String
  actorId   String?
  action    String
  data      Json?

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([action])
  @@index([actorId])
}

/**
 * =========================
 * RATINGS (IMMUTABLE) - EXISTING (BD rating)
 * =========================
 */

model ProjectRating {
  id        String @id @default(cuid())
  projectId String @unique

  communication   Int
  quality         Int
  speed           Int
  professionalism Int?

  ratedById String
  ratedBy   User @relation("ProjectRatedBy", fields: [ratedById], references: [id], onDelete: Restrict)

  ratedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([ratedById])
}

/**
 * =========================
 * PAYMENTS (REMOTE ONLY)
 * =========================
 */

model ProjectPaymentLine {
  id String @id @default(cuid())

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation("PaymentLineUser", fields: [userId], references: [id], onDelete: Cascade)

  amount    Decimal
  status    PaymentLineStatus @default(UNPAID)
  payableOn DateTime?  // null until firstCompletedAt is set

  paidAt   DateTime?
  paidById String?
  paidBy   User? @relation("PaymentMarkedBy", fields: [paidById], references: [id], onDelete: SetNull)

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([projectId])
  @@index([payableOn])
}

/**
 * =========================
 * ONSITE PERFORMANCE (STEP 11)
 * =========================
 */

model OnsiteProjectRating {
  id String @id @default(cuid())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // 5-star metrics (1..5)
  m1 Int
  m2 Int
  m3 Int
  m4 Int
  m5 Int

  ratedById String
  ratedBy   User @relation("OnsiteRatedBy", fields: [ratedById], references: [id], onDelete: Restrict)

  ratedAt DateTime @default(now())

  @@index([ratedById])
}

model OnsitePointCredit {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation("OnsiteCreditUser", fields: [userId], references: [id], onDelete: Cascade)

  // Final credited points for this worker for this project (manual split)
  points Int

  // Who set it (admin/manager/bd)
  setById String?
  setBy   User? @relation("OnsiteCreditSetBy", fields: [setById], references: [id], onDelete: SetNull)

  // Derived from project.firstCompletedAt for reporting (YYYY-MM)
  monthKey String

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId, monthKey])
  @@index([projectId])
  @@index([setById])
}

/**
 * =========================
 * INVITES (MINI-STEP 13)
 * =========================
 */

model UserInvite {
  id String @id @default(cuid())

  email String

  // Role + worker type are decided at invite time
  role       Role
  workerType WorkerType?

  status InviteStatus @default(PENDING)

  // Store only a hash of the token (never store raw token)
  tokenHash String @unique

  expiresAt  DateTime
  acceptedAt DateTime?

  // who created the invite
  createdById String
  createdBy   User @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // departments selected at invite-time
  departments UserInviteDepartment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdById])
  @@index([expiresAt])
}

model UserInviteDepartment {
  inviteId     String
  departmentId String

  invite     UserInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([inviteId, departmentId])
  @@index([departmentId])
}

/**
 * =========================
 * PASSWORD RESET (MINI-STEP 13)
 * =========================
 */

model PasswordResetToken {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Store only a hash of the token (never store raw token)
  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  title     String
  body      String?
  href      String?
  projectId String?

  actorId   String?
  createdAt DateTime @default(now())
  readAt    DateTime?

  // ✅ opposite side for NotificationDelivery.notification
  deliveries NotificationDelivery[]

  @@index([userId, readAt, createdAt])
  @@index([projectId])
  @@index([type, createdAt])
}

model NotificationPreference {
  userId String @id
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Email: ONLY for assigned-project events (defaults true if row missing)
  emailProjectMessages   Boolean @default(true)
  emailProjectStatus     Boolean @default(true)
  emailProjectCompletion Boolean @default(true)
  emailProjectRatings    Boolean @default(true)
  emailAssignments       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationDelivery {
  id             String        @id @default(cuid())
  notificationId String?
  notification   Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  userId String?
  user   User? @relation("NotificationDeliveryRecipient", fields: [userId], references: [id], onDelete: SetNull)

  toEmail String
  subject String
  html    String

  status        NotificationDeliveryStatus @default(PENDING)
  attempts      Int                        @default(0)
  lastAttemptAt DateTime?
  sentAt        DateTime?
  error         String?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([userId])
}

model ProjectWatcher {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}


model SystemSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}