model UserRateHistory {
  id                  String   @id @default(cuid())
  userId              String
  effectiveFrom       DateTime
  onsiteHourRatePkr   Int?
  targetMonthlyPoints Int?
  note                String?
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user      User  @relation("UserRateHistoryUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("UserRateHistoryCreatedBy", fields: [createdById], references: [id])

  @@unique([userId, effectiveFrom])
  @@index([effectiveFrom])
}

model BdMonthlySettlement {
  id                String   @id @default(cuid())
  monthKey          String
  bdId              String
  bdRate            Decimal  @db.Decimal(5, 4)
  revenuePkr        Decimal  @db.Decimal(14, 2)
  remotePayoutPkr   Decimal  @db.Decimal(14, 2)
  costSalariesPkr   Decimal  @db.Decimal(14, 2)
  costOverheadPkr   Decimal  @db.Decimal(14, 2)
  costBasePkr       Decimal  @db.Decimal(14, 2)
  profitPkr         Decimal  @db.Decimal(14, 2)
  payoutPkr         Decimal  @db.Decimal(14, 2)
  projectCount      Int      @default(0)
  excludedPaidCount Int      @default(0)
  capacityHours     Decimal  @default(0) @db.Decimal(10, 2)
  usedHours         Decimal  @default(0) @db.Decimal(10, 2)
  computedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  bd User @relation("BdSettlementBd", fields: [bdId], references: [id], onDelete: Cascade)

  @@unique([monthKey, bdId])
  @@index([monthKey])
  @@index([bdId])
}
