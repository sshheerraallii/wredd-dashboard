generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                   @id @default(cuid())
  fullName                  String
  username                  String                   @unique
  email                     String                   @unique
  passwordHash              String
  role                      Role
  workerType                WorkerType?
  archivedAt                DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  targetMonthlyPoints       Int                      @default(0)
  image                     String?
  lastActiveAt              DateTime?
  statusText                String?
  avatarPath                String?
  joinedAt                  DateTime                 @default(now())
  bdCommissionRate          Decimal?                 @db.Decimal(5, 4)
  onsiteHourRatePkr         Int?
  bdCommissions             BdCommission[]           @relation("BdCommissionBd")
  bdCommissionExceptionPaid BdCommission[]           @relation("BdCommissionExceptionPaidBy")
  bdCommissionPaid          BdCommission[]           @relation("BdCommissionPaidBy")
  bdAdjustments             BdCommissionAdjustment[]
  createdBdAdjustments      BdCommissionAdjustment[] @relation("BdAdjustmentCreatedBy")
  notifications             Notification[]           @relation("NotificationRecipient")
  notificationDeliveries    NotificationDelivery[]   @relation("NotificationDeliveryRecipient")
  notificationPreferences   NotificationPreference?
  onsiteCreditsSetBy        OnsitePointCredit[]      @relation("OnsiteCreditSetBy")
  onsiteCredits             OnsitePointCredit[]      @relation("OnsiteCreditUser")
  onsiteRatedBy             OnsiteProjectRating[]    @relation("OnsiteRatedBy")
  opsTasksAssigned          OpsTask[]                @relation("OpsTaskAssignee")
  opsTasksCreated           OpsTask[]                @relation("OpsTaskCreatedBy")
  opsTaskInstances          OpsTaskInstance[]        @relation("OpsTaskInstanceAssignee")
  opsTasksExtended          OpsTaskInstance[]        @relation("OpsTaskInstanceExtendedBy")
  opsTasksReopened          OpsTaskInstance[]        @relation("OpsTaskInstanceReopenedBy")
  passwordResets            PasswordResetToken[]
  bdOwnedProjects           Project[]                @relation("ProjectBdOwner")
  createdProjects           Project[]                @relation("ProjectCreatedBy")
  activities                ProjectActivity[]        @relation("ActivityActor")
  assignedByLinks           ProjectAssignment[]      @relation("AssignmentAssignedBy")
  assignments               ProjectAssignment[]      @relation("AssignmentUser")
  projectLastSeen           ProjectLastSeen[]
  messages                  ProjectMessage[]         @relation("MessageCreatedBy")
  paymentMarkedByLogs       ProjectPaymentLine[]     @relation("PaymentMarkedBy")
  paymentLines              ProjectPaymentLine[]     @relation("PaymentLineUser")
  ratingsGiven              ProjectRating[]          @relation("ProjectRatedBy")
  watchedProjects           ProjectWatcher[]
  departments               UserDepartment[]
  invitesCreated            UserInvite[]             @relation("InviteCreatedBy")
  bdAllocations             BdDepartmentAllocation[] @relation("BdAllocationBd")
  targetSnapshotsTaken      BdTargetSnapshot[]       @relation("SnapshotBy")
  manualPerfPoints          ManualPerformancePoint[] @relation("ManualPerfUser")
  manualPerfPointsCreated   ManualPerformancePoint[] @relation("ManualPerfCreatedBy")
  clientPaymentReceiptsRecorded ClientPaymentReceipt[] @relation("ClientPaymentReceiptRecordedBy")
  rateHistory                   UserRateHistory[]      @relation("UserRateHistoryUser")
  rateHistoryCreated            UserRateHistory[]      @relation("UserRateHistoryCreatedBy")
  bdSettlements                 BdMonthlySettlement[]  @relation("BdSettlementBd")

  @@index([role])
  @@index([workerType])
  @@index([email])
  @@index([joinedAt])
  @@index([bdCommissionRate])
}

model MonthlyFinanceConfig {
  id                     String    @id @default(cuid())
  monthKey               String    @unique
  fxRate                 Decimal   @db.Decimal(12, 4)
  avgOnsiteHourCostPkr   Int
  remoteOverheadFixedPkr Int
  overheadPoolPkr        Int       @default(0)
  workingDays            Int?
  finalizedAt            DateTime?
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([monthKey])
  @@index([finalizedAt])
}

/// BD revenue-target allocation: each BD's % share of a department's monthly
/// capacity target. Sums to 100% per (monthKey, department). System BD included.
/// New months copy-forward from the most recent prior month, then editable.
model BdDepartmentAllocation {
  id           String     @id @default(cuid())
  monthKey     String
  bdId         String
  departmentId String
  sharePercent Decimal    @db.Decimal(5, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  bd           User       @relation("BdAllocationBd", fields: [bdId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([monthKey, bdId, departmentId])
  @@index([monthKey])
  @@index([bdId])
  @@index([departmentId])
}

/// Closed-book month snapshot: freezes Target + Achieved at department level so
/// later salary/point changes or project deletions never rewrite history.
/// Manual only (Super Admin presses snapshot). Department name denormalized so
/// the record is self-contained. Per-BD history = targetUsd x stored allocation.
model BdTargetSnapshot {
  id              String     @id @default(cuid())
  monthKey        String
  departmentId    String
  departmentName  String
  targetPoints    Int
  targetUsd       Decimal    @db.Decimal(14, 2)
  achievedUsd     Decimal    @db.Decimal(14, 2)
  dollarsPerPoint Int        @default(6)
  snapshotAt      DateTime   @default(now())
  snapshotById    String?
  snapshotBy      User?      @relation("SnapshotBy", fields: [snapshotById], references: [id])

  @@unique([monthKey, departmentId])
  @@index([monthKey])
}

model Department {
  id                String                 @id @default(cuid())
  name              String                 @unique
  slug              String                 @unique
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  projects          Project[]
  users             UserDepartment[]
  inviteDepartments UserInviteDepartment[]
  bdAllocations     BdDepartmentAllocation[]
}

model UserDepartment {
  userId       String
  departmentId String
  createdAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@index([departmentId])
}

model ProjectClassDefinition {
  id         String       @id @default(cuid())
  class      ProjectClass @unique
  basePoints Int
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  projects   Project[]
}

model Project {
  id                               String                  @id @default(cuid())
  title                            String
  description                      String?
  departmentId                     String
  status                           ProjectStatus           @default(UNASSIGNED)
  /// *
  ///    * ---- Deadline + Timer (V1 final) ----
  deadlineHours                    Int                     @default(0)
  timerRunning                     Boolean                 @default(false)
  timerLastResumedAt               DateTime?
  timerAccumulatedSeconds          Int                     @default(0)
  classBasePointsAtFirstCompletion Int?
  /// *
  ///    * ---- Remote (V1) ----
  remotePrice                      Decimal?
  /// *
  ///    * ---- Immutable first completion ----
  firstCompletedAt                 DateTime?
  /// *
  ///    * ---- First delivery (set once, when status first becomes DELIVERED) ----
  ///    * Used to distinguish a first-pass IN_PROGRESS (30% estimate) from a
  ///    * post-delivery REVISION / bounce-back (70% estimate).
  firstDeliveredAt                 DateTime?
  /// *
  ///    * ---- Creator ----
  createdById                      String
  createdAt                        DateTime                @default(now())
  updatedAt                        DateTime                @updatedAt
  extraPoints                      Int?
  /// *
  ///    * ---- Onsite (V1) ----
  onsitePointsManual               Int?
  projectClassDefinitionId         String?
  /// *
  ///    * ---- Status timestamps (NEW) ----
  ///    * cancelledAt: set exactly when status becomes CANCELLED
  ///    * statusChangedAt: set on every status change (useful for audits/analytics)
  cancelledAt                      DateTime?
  statusChangedAt                  DateTime?
  /// *
  ///    * ---- BD ownership (Mini-Step 3) ----
  bdOwnerId                        String?
  isSample                         Boolean                 @default(false)
  bdCommissions                    BdCommission[]          @relation("BdCommissionProject")
  onsiteCredits                    OnsitePointCredit[]
  onsiteRating                     OnsiteProjectRating?
  bdOwner                          User?                   @relation("ProjectBdOwner", fields: [bdOwnerId], references: [id])
  createdBy                        User                    @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  department                       Department              @relation(fields: [departmentId], references: [id])
  projectClassDefinition           ProjectClassDefinition? @relation(fields: [projectClassDefinitionId], references: [id])
  activities                       ProjectActivity[]
  assignments                      ProjectAssignment[]
  finance                          ProjectFinance?
  lastSeenBy                       ProjectLastSeen[]
  messages                         ProjectMessage[]
  paymentLines                     ProjectPaymentLine[]
  rating                           ProjectRating?
  watchers                         ProjectWatcher[]
  clientPaymentReceipts            ClientPaymentReceipt[]

  @@index([departmentId])
  @@index([status])
  @@index([createdById])
  @@index([bdOwnerId])
  @@index([cancelledAt])
  @@index([statusChangedAt])
}

model ProjectFinance {
  id                 String        @id @default(cuid())
  projectId          String        @unique
  clientName         String?
  clientUsername     String?
  workType           WorkType      @default(REMOTE)
  portal             ProjectPortal @default(OTHER)
  priceUsd           Decimal       @default(0) @db.Decimal(12, 2)
  platformFeeUsd     Decimal?      @db.Decimal(12, 2)
  allowedHours       Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  platformFeePercent Decimal?      @db.Decimal(5, 2)
  project            Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([portal])
  @@index([workType])
}

model BdCommissionAdjustment {
  id          String          @id @default(cuid())
  bdUserId    String
  monthKey    String
  tab         BdCommissionTab
  amountPkr   Decimal         @db.Decimal(14, 2)
  note        String
  dueOn       DateTime
  paidAt      DateTime?
  createdById String
  createdAt   DateTime        @default(now())
  bdUser      User            @relation(fields: [bdUserId], references: [id], onDelete: Cascade)
  createdBy   User            @relation("BdAdjustmentCreatedBy", fields: [createdById], references: [id])

  @@index([bdUserId, monthKey])
  @@index([tab, dueOn])
}

model BdCommission {
  id                     String          @id @default(cuid())
  projectId              String
  bdId                   String
  completedMonthKey      String
  tab                    BdCommissionTab @default(ACTIVE)
  dueOn                  DateTime
  payableOn              DateTime
  workType               WorkType
  portal                 ProjectPortal
  priceUsd               Decimal         @db.Decimal(12, 2)
  platformFeeUsd         Decimal         @db.Decimal(12, 2)
  fxRate                 Decimal         @db.Decimal(12, 4)
  avgOnsiteHourCostPkr   Int
  remoteOverheadFixedPkr Int
  allowedHours           Int?
  bdRate                 Decimal         @db.Decimal(5, 4)
  netUsd                 Decimal         @db.Decimal(12, 2)
  netPkr                 Decimal         @db.Decimal(14, 2)
  overheadPkr            Decimal         @db.Decimal(14, 2)
  profitPkr              Decimal         @db.Decimal(14, 2)
  bdPayoutPkr            Decimal         @db.Decimal(14, 2)
  companySharePkr        Decimal         @db.Decimal(14, 2)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  exceptionPaidAt        DateTime?
  exceptionPaidById      String?
  exceptionPaidNote      String?
  paidAt                 DateTime?
  paidById               String?
  paidNote               String?
  platformFeePercent     Decimal?        @db.Decimal(5, 2)
  workerPayoutPkr        Decimal         @default(0) @db.Decimal(14, 2)
  bd                     User            @relation("BdCommissionBd", fields: [bdId], references: [id])
  exceptionPaidBy        User?           @relation("BdCommissionExceptionPaidBy", fields: [exceptionPaidById], references: [id])
  paidBy                 User?           @relation("BdCommissionPaidBy", fields: [paidById], references: [id])
  project                Project         @relation("BdCommissionProject", fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, completedMonthKey])
  @@index([bdId, tab])
  @@index([completedMonthKey])
  @@index([payableOn])
  @@index([tab])
  @@index([paidAt])
  @@index([exceptionPaidAt])
}

model ProjectAssignment {
  id                   String            @id @default(cuid())
  projectId            String
  userId               String
  assignedById         String?
  assignedAt           DateTime          @default(now())
  unassignedAt         DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  cancelledForWorkerAt DateTime?
  completedAt          DateTime?
  outcome              AssignmentOutcome @default(ACTIVE)
  allocatedHours       Int?
  hoursLate            Int?
  /// *
  ///    * ---- Estimated-points constant snapshots (going-forward-only) ----
  ///    * Captured when allocatedHours is set, so editing the global constants
  ///    * later never retroactively changes an existing project's estimate.
  ///    * Null on legacy rows -> reader falls back to current global settings.
  prodMultipleSnapshot    Decimal? @db.Decimal(6, 2)
  dollarsPerPointSnapshot Int?
  assignedBy           User?             @relation("AssignmentAssignedBy", fields: [assignedById], references: [id])
  project              Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                 User              @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
  @@index([assignedById])
  @@index([outcome])
  @@index([cancelledForWorkerAt])
  @@index([completedAt])
}

model ProjectMessage {
  id          String      @id @default(cuid())
  projectId   String
  createdById String?
  type        MessageType
  content     String?
  linkUrl     String?
  meta        Json?
  createdAt   DateTime    @default(now())
  createdBy   User?       @relation("MessageCreatedBy", fields: [createdById], references: [id])
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([type])
  @@index([createdById])
}

model ProjectActivity {
  id        String   @id @default(cuid())
  projectId String
  actorId   String?
  action    String
  data      Json?
  createdAt DateTime @default(now())
  actor     User?    @relation("ActivityActor", fields: [actorId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([action])
  @@index([actorId])
}

model ProjectRating {
  id              String   @id @default(cuid())
  projectId       String   @unique
  communication   Int
  quality         Int
  speed           Int
  professionalism Int?
  ratedById       String
  ratedAt         DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ratedBy         User     @relation("ProjectRatedBy", fields: [ratedById], references: [id])

  @@index([ratedById])
}

model ProjectPaymentLine {
  id        String            @id @default(cuid())
  projectId String?
  userId    String
  amount    Decimal
  status    PaymentLineStatus @default(UNPAID)
  payableOn DateTime?
  paidAt    DateTime?
  paidById  String?
  note      String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  paidBy    User?             @relation("PaymentMarkedBy", fields: [paidById], references: [id])
  project   Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User              @relation("PaymentLineUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([projectId])
  @@index([payableOn])
}

/// *
///    * ---- Client Payment Tracking (Super Admin only) ----
///    * Tracks whether clients have paid for a project (separate from
///    * ProjectPaymentLine, which tracks WHAT WE OWE WORKERS).
///    * A project's "received" status is derived by comparing the sum of
///    * its receipts against ProjectFinance.priceUsd — never stored directly.
model PaymentAccount {
  id         String              @id @default(cuid())
  name       String              @unique
  type       PaymentAccountType  @default(OTHER)
  ownerLabel String?
  isActive   Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  receipts   ClientPaymentReceipt[]

  @@index([isActive])
}

model ClientPaymentReceipt {
  id              String            @id @default(cuid())
  projectId       String
  accountId       String
  amountUsd       Decimal           @db.Decimal(12, 2)
  receivedAt      DateTime
  /// *
  ///    * fundStatus: lifecycle of the money after it lands in the account.
  ///    * IN_HAND               -> received, sitting in the account, untouched
  ///    * UTILIZED              -> spent directly out of that account, will never move to WREDD FBL
  ///    * SETTLED_TO_WREDD_FBL  -> physically transferred into the main WREDD FBL account
  fundStatus      ReceiptFundStatus @default(IN_HAND)
  statusNote      String?
  statusUpdatedAt DateTime?
  note            String?
  recordedById    String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  account    PaymentAccount @relation(fields: [accountId], references: [id])
  recordedBy User           @relation("ClientPaymentReceiptRecordedBy", fields: [recordedById], references: [id])

  @@index([projectId])
  @@index([accountId])
  @@index([receivedAt])
  @@index([fundStatus])
}

model OnsiteProjectRating {
  id        String   @id @default(cuid())
  projectId String   @unique
  m1        Int
  m2        Int
  m3        Int
  m4        Int
  m5        Int
  ratedById String
  ratedAt   DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ratedBy   User     @relation("OnsiteRatedBy", fields: [ratedById], references: [id])

  @@index([ratedById])
}

model OnsitePointCredit {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  points    Int
  setById   String?
  monthKey  String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  setBy     User?    @relation("OnsiteCreditSetBy", fields: [setById], references: [id])
  user      User     @relation("OnsiteCreditUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, monthKey])
  @@index([projectId])
  @@index([setById])
}

/// Manual performance points awarded by Manager / Super Admin for things the
/// project-points system can't capture (attitude, extra effort, a fine, etc.).
/// - points may be NEGATIVE (a fine) or positive (a bonus).
/// - note is REQUIRED (why the adjustment was made).
/// - FINALIZED-only: counts toward target progress, never shown as estimated.
/// - attributed to the month it was GIVEN (monthKey), independent of any project.
model ManualPerformancePoint {
  id          String   @id @default(cuid())
  userId      String
  points      Int
  note        String
  monthKey    String
  createdById String?
  createdAt   DateTime @default(now())
  user        User     @relation("ManualPerfUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("ManualPerfCreatedBy", fields: [createdById], references: [id])

  @@index([userId, monthKey])
  @@index([createdById])
}

model UserInvite {
  id          String                 @id @default(cuid())
  email       String
  role        Role
  workerType  WorkerType?
  status      InviteStatus           @default(PENDING)
  tokenHash   String                 @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  createdBy   User                   @relation("InviteCreatedBy", fields: [createdById], references: [id])
  departments UserInviteDepartment[]

  @@index([email])
  @@index([status])
  @@index([createdById])
  @@index([expiresAt])
}

model UserInviteDepartment {
  inviteId     String
  departmentId String
  createdAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  invite       UserInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@id([inviteId, departmentId])
  @@index([departmentId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Notification {
  id         String                 @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  body       String?
  href       String?
  projectId  String?
  actorId    String?
  createdAt  DateTime               @default(now())
  readAt     DateTime?
  user       User                   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, readAt, createdAt])
  @@index([projectId])
  @@index([type, createdAt])
}

model NotificationPreference {
  userId                 String   @id
  emailProjectMessages   Boolean  @default(true)
  emailProjectStatus     Boolean  @default(true)
  emailProjectCompletion Boolean  @default(true)
  emailProjectRatings    Boolean  @default(true)
  emailAssignments       Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  emailTaskAssigned      Boolean  @default(true)
  emailTaskDueSoon       Boolean  @default(true)
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationDelivery {
  id             String                     @id @default(cuid())
  notificationId String?
  userId         String?
  toEmail        String
  subject        String
  html           String
  status         NotificationDeliveryStatus @default(PENDING)
  attempts       Int                        @default(0)
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  error          String?
  createdAt      DateTime                   @default(now())
  notification   Notification?              @relation(fields: [notificationId], references: [id])
  user           User?                      @relation("NotificationDeliveryRecipient", fields: [userId], references: [id])

  @@index([status, createdAt])
  @@index([userId])
}

model ProjectWatcher {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

model SystemSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectLastSeen {
  userId    String
  projectId String
  seenAt    DateTime
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model OpsTask {
  id          String            @id @default(cuid())
  title       String
  description String?
  type        OpsTaskType
  assigneeId  String
  createdById String
  timerHours  Int
  runOnDays   Int[]
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  assignee    User              @relation("OpsTaskAssignee", fields: [assigneeId], references: [id])
  createdBy   User              @relation("OpsTaskCreatedBy", fields: [createdById], references: [id])
  instances   OpsTaskInstance[]

  @@index([assigneeId])
  @@index([createdById])
  @@index([type, isActive])
}

model OpsTaskInstance {
  id                   String    @id @default(cuid())
  taskId               String
  assigneeId           String
  title                String
  timerHours           Int
  dueAt                DateTime
  originalDueAt        DateTime
  deadlineExtendedAt   DateTime?
  deadlineExtendedById String?
  status               String    @default("PENDING")
  completedAt          DateTime?
  completionNote       String?
  points               Int?
  reopenedAt           DateTime?
  reopenedById         String?
  dueSoonNotifiedAt    DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  assignee             User      @relation("OpsTaskInstanceAssignee", fields: [assigneeId], references: [id])
  deadlineExtendedBy   User?     @relation("OpsTaskInstanceExtendedBy", fields: [deadlineExtendedById], references: [id])
  reopenedBy           User?     @relation("OpsTaskInstanceReopenedBy", fields: [reopenedById], references: [id])
  task                 OpsTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([assigneeId, status])
  @@index([taskId])
  @@index([dueAt])
  @@index([status, dueAt])
  @@index([assigneeId, createdAt])
}

enum Role {
  SUPER_ADMIN
  MANAGER
  BUSINESS_DEVELOPER
  REMOTE_WORKER
  ONSITE_EMPLOYEE
}

enum WorkerType {
  ONSITE_VIDEO_EDITOR
  REMOTE_VIDEO_EDITOR
  ONSITE_ANIMATOR
  REMOTE_ANIMATOR
  WEB_DEVELOPMENT
  OPERATIONS
}

enum WorkType {
  ONSITE
  REMOTE
}

enum ProjectPortal {
  UPWORK
  FIVERR
  DIRECT
  OTHER
}

enum BdCommissionTab {
  ACTIVE
  CLEARING
  DUE
  PAID
}

enum ProjectStatus {
  UNASSIGNED
  IN_PROGRESS
  DELIVERED
  REVISION
  COMPLETED
  CANCELLED
