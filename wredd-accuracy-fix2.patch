From 2834006e90997f20784400f60bb7d054e9d54c36 Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic.com>
Date: Tue, 2 Jun 2026 15:05:06 +0000
Subject: [PATCH] fix: exclude empty months from points accuracy average
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Previously, months with no credited projects counted as 0% accuracy,
dragging down the overall score unfairly. A worker who joined in Aug 2025
but only had projects in May 2026 would show ~1% overall accuracy because
9 months of 0% were averaged in.

Now only months with at least 1 OnsitePointCredit row are included in
the accuracy average. Empty months show — in the history table.

Fixes: overall accuracy, range-selected accuracy, last-6-months table.
Both worker/performance/page.tsx and admin performance/page.tsx updated.
---
 app/(protected)/app/performance/page.tsx        |  8 ++++++++
 app/(protected)/app/worker/performance/page.tsx | 13 +++++++++++--
 2 files changed, 19 insertions(+), 2 deletions(-)

diff --git a/app/(protected)/app/performance/page.tsx b/app/(protected)/app/performance/page.tsx
index f3cc759..f58affe 100644
--- a/app/(protected)/app/performance/page.tsx
+++ b/app/(protected)/app/performance/page.tsx
@@ -482,8 +482,12 @@ async function onsiteMonthlyAccuracyAvg(params: {
   const sums: Record<string, number> = {};
   for (const c of credits) sums[c.monthKey] = (sums[c.monthKey] ?? 0) + c.points;
 
+  // ✅ Only include months with actual credited projects
+  const monthsWithActivity = new Set(Object.keys(sums));
+
   const accuracies: number[] = [];
   for (const mk of monthKeys) {
+    if (!monthsWithActivity.has(mk)) continue;
     const achieved = sums[mk] ?? 0;
     const target = proratedMonthlyTarget({
       targetMonthlyPoints: params.targetMonthlyPoints,
@@ -625,8 +629,12 @@ async function onsiteAccuracyAvgForMonthKeys(params: {
   const sums: Record<string, number> = {};
   for (const c of credits) sums[c.monthKey] = (sums[c.monthKey] ?? 0) + c.points;
 
+  // ✅ Only include months with actual credited projects
+  const monthsWithActivity = new Set(Object.keys(sums));
+
   const accuracies: number[] = [];
   for (const mk of params.monthKeys) {
+    if (!monthsWithActivity.has(mk)) continue;
     const achieved = sums[mk] ?? 0;
     const target = proratedMonthlyTarget({
       targetMonthlyPoints: params.targetMonthlyPoints,
diff --git a/app/(protected)/app/worker/performance/page.tsx b/app/(protected)/app/worker/performance/page.tsx
index a219958..5a75376 100644
--- a/app/(protected)/app/worker/performance/page.tsx
+++ b/app/(protected)/app/worker/performance/page.tsx
@@ -469,8 +469,15 @@ const completed =
       });
       const sums: Record<string, number> = {};
       for (const c of credits) sums[c.monthKey] = (sums[c.monthKey] ?? 0) + c.points;
+
+      // ✅ Only include months where the worker actually had credited projects.
+      // Months with no activity (no OnsitePointCredit rows) are excluded from
+      // the average — it's unfair to count a month where no projects were assigned.
+      const monthsWithActivity = new Set(Object.keys(sums));
+
       const accuracies: number[] = [];
       for (const k of monthKeys) {
+        if (!monthsWithActivity.has(k)) continue; // skip months with no credited projects
         const achieved = sums[k] ?? 0;
         const target = proratedMonthlyTarget({
           targetMonthlyPoints: me.targetMonthlyPoints,
@@ -510,14 +517,16 @@ const completed =
     const history = months.map((m) => {
       const g = grouped[m.key];
       const achieved = g?.points ?? 0;
+      const hasActivity = !!g && achieved > 0;
       const avgRating = g?.ratings?.length ? avg(g.ratings) : null;
       const t = proratedMonthlyTarget({
         targetMonthlyPoints: me.targetMonthlyPoints,
         joinedAt: me.joinedAt,
         monthKey: m.key,
       });
-      const acc = t > 0 ? Math.round((achieved / t) * 100) : null;
-      return { monthKey: m.key, achievedPoints: achieved, accuracy: acc, avgRating };
+      // Only show accuracy for months with actual credited projects
+      const acc = hasActivity && t > 0 ? Math.round((achieved / t) * 100) : null;
+      return { monthKey: m.key, achievedPoints: achieved, accuracy: acc, avgRating, hasActivity };
     });
 
     let allMonthKeys: string[] = [];
